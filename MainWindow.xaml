<Window x:Class="NetworkHealthMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:NetworkHealthMonitor.Converters"
        xmlns:shellViews="clr-namespace:NetworkHealthMonitor.Views.Shell"
        xmlns:dashboardVm="clr-namespace:NetworkHealthMonitor.ViewModels.Dashboard"
        xmlns:dashboardViews="clr-namespace:NetworkHealthMonitor.Views.Dashboard"
        xmlns:devicesVm="clr-namespace:NetworkHealthMonitor.ViewModels.Devices"
        xmlns:devicesViews="clr-namespace:NetworkHealthMonitor.Views.Devices"
        xmlns:liveVm="clr-namespace:NetworkHealthMonitor.ViewModels.LiveStatus"
        xmlns:liveViews="clr-namespace:NetworkHealthMonitor.Views.LiveStatus"
        xmlns:schedulesVm="clr-namespace:NetworkHealthMonitor.ViewModels.Schedules"
        xmlns:schedulesViews="clr-namespace:NetworkHealthMonitor.Views.Schedules"
        xmlns:historyVm="clr-namespace:NetworkHealthMonitor.ViewModels.PingHistory"
        xmlns:historyViews="clr-namespace:NetworkHealthMonitor.Views.PingHistory"
        xmlns:incidentsVm="clr-namespace:NetworkHealthMonitor.ViewModels.Incidents"
        xmlns:incidentsViews="clr-namespace:NetworkHealthMonitor.Views.Incidents"
        xmlns:notificationsVm="clr-namespace:NetworkHealthMonitor.ViewModels.Notifications"
        xmlns:notificationsViews="clr-namespace:NetworkHealthMonitor.Views.Notifications"
        xmlns:reportsVm="clr-namespace:NetworkHealthMonitor.ViewModels.Reports"
        xmlns:reportsViews="clr-namespace:NetworkHealthMonitor.Views.Reports"
        xmlns:workerVm="clr-namespace:NetworkHealthMonitor.ViewModels.Worker"
        xmlns:workerViews="clr-namespace:NetworkHealthMonitor.Views.Worker"
        xmlns:healthVm="clr-namespace:NetworkHealthMonitor.ViewModels.SystemHealth"
        xmlns:healthViews="clr-namespace:NetworkHealthMonitor.Views.SystemHealth"
        xmlns:settingsVm="clr-namespace:NetworkHealthMonitor.ViewModels.Settings"
        xmlns:settingsViews="clr-namespace:NetworkHealthMonitor.Views.Settings"
        xmlns:helpVm="clr-namespace:NetworkHealthMonitor.ViewModels.Help"
        xmlns:helpViews="clr-namespace:NetworkHealthMonitor.Views.Help"
        xmlns:aboutVm="clr-namespace:NetworkHealthMonitor.ViewModels.About"
        xmlns:aboutViews="clr-namespace:NetworkHealthMonitor.Views.About"
        mc:Ignorable="d"
        Title="Ağ İzleme Yönetim Paneli"
        Height="860"
        Width="1440"
        MinHeight="720"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:BooleanToGridLengthConverter x:Key="NavigationWidthConverter" TrueWidth="64" FalseWidth="232" />
            <converters:CollapsedCenterAlignmentConverter x:Key="CollapsedCenterAlignmentConverter" />
            <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter" />
            <converters:StatusForegroundConverter x:Key="StatusForegroundConverter" />

            <Style x:Key="NavGlyphStyle" TargetType="TextBlock">
                <Setter Property="Width" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#E5E7EB" />
            </Style>

            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ShellTextBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MicroLabelTextStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="PageScrollStyle" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="QuietCardStyle" TargetType="Border" BasedOn="{StaticResource PanelSurfaceStyle}">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="CompactDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="SelectionMode" Value="Extended" />
                <Setter Property="SelectionUnit" Value="FullRow" />
            </Style>

            <DataTemplate DataType="{x:Type dashboardVm:DashboardViewModel}">
                <dashboardViews:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type devicesVm:DevicesViewModel}">
                <devicesViews:DevicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type devicesVm:DeviceDetailsViewModel}">
                <devicesViews:DeviceDetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type devicesVm:DeviceGroupsViewModel}">
                <devicesViews:DeviceGroupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type liveVm:LiveStatusViewModel}">
                <liveViews:LiveStatusView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type schedulesVm:SchedulesViewModel}">
                <schedulesViews:SchedulesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type historyVm:PingHistoryViewModel}">
                <historyViews:PingHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type incidentsVm:IncidentsViewModel}">
                <incidentsViews:IncidentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type notificationsVm:NotificationsViewModel}">
                <notificationsViews:NotificationsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type reportsVm:ReportsViewModel}">
                <reportsViews:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type workerVm:WorkerServiceViewModel}">
                <workerViews:WorkerServiceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type healthVm:SystemHealthViewModel}">
                <healthViews:SystemHealthView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type settingsVm:SettingsViewModel}">
                <settingsViews:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type helpVm:HelpViewModel}">
                <helpViews:HelpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type aboutVm:AboutViewModel}">
                <aboutViews:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <shellViews:MainShellView />
</Window>
