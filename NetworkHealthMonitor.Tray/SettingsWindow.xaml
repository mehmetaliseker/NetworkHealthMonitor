<Window x:Class="NetworkHealthMonitor.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Health Monitor Ayarları"
        Width="460"
        Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Sistem tepsisi ayarları"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="StartTrayOnWindowsLoginCheckBox"
                      Content="Windows açıldığında tray uygulamasını başlat"
                      Margin="0,0,0,12" />
            <CheckBox x:Name="StartWorkerWhenTrayStartsCheckBox"
                      Content="Tray uygulaması açıldığında Worker'ı başlat"
                      Margin="0,0,0,12" />
            <TextBlock Text="İkinci seçenek Worker hizmetini otomatik başlangıç türüne çevirmez."
                       Foreground="#64748B"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Vazgeç" Width="90" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Kaydet" Width="90" IsDefault="True" Click="SaveClicked" />
        </StackPanel>
    </Grid>
</Window>
