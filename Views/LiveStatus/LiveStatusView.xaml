<UserControl x:Class="NetworkHealthMonitor.Views.LiveStatus.LiveStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel>
            <Border Style="{StaticResource PanelSectionStyle}">
                <WrapPanel>
                    <ComboBox Width="180"
                              ItemsSource="{Binding Legacy.DeviceGroupFilterOptions}"
                              SelectedItem="{Binding Legacy.LiveGroupFilter}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ToolTip="Grup filtresi"
                              AutomationProperties.Name="Canli durum grup filtresi" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding Legacy.DeviceTypeFilterOptions}"
                              SelectedItem="{Binding Legacy.LiveTypeFilter}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ToolTip="Tur filtresi"
                              AutomationProperties.Name="Canli durum tur filtresi" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding Legacy.DeviceStatusFilterOptions}"
                              SelectedItem="{Binding Legacy.LiveStatusFilter}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              ToolTip="Durum filtresi"
                              AutomationProperties.Name="Canli durum durum filtresi" />
                </WrapPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelSectionStyle}" Margin="0,0,8,14">
                    <StackPanel>
                        <TextBlock Text="Cevrimici Cihazlar" Style="{StaticResource SectionHeadingStyle}" />
                        <DataGrid ItemsSource="{Binding Legacy.LiveOnlineDevices}"
                                  SelectedItem="{Binding Legacy.SelectedDevice}"
                                  Style="{StaticResource CompactDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                  MaxHeight="260">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding LastStatus, Converter={StaticResource RowStatusBackgroundConverter}}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP / Hostname" Binding="{Binding IpAddress}" Width="150" />
                                <DataGridTextColumn Header="Cihaz" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="Durum" Width="130" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPillStyle}"
                                                    Background="{Binding LastStatus, Converter={StaticResource StatusBackgroundConverter}}">
                                                <TextBlock Text="{Binding LastStatusText}"
                                                           Foreground="{Binding LastStatus, Converter={StaticResource StatusForegroundConverter}}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Son Kontrol" Binding="{Binding LastCheckedAtText}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelSectionStyle}" Margin="8,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Erisilemeyen Cihazlar" Style="{StaticResource SectionHeadingStyle}" />
                        <DataGrid ItemsSource="{Binding Legacy.LiveOfflineDevices}"
                                  SelectedItem="{Binding Legacy.SelectedDevice}"
                                  Style="{StaticResource CompactDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                  MaxHeight="260">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding LastStatus, Converter={StaticResource RowStatusBackgroundConverter}}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP / Hostname" Binding="{Binding IpAddress}" Width="150" />
                                <DataGridTextColumn Header="Cihaz" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="Durum" Width="130" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPillStyle}"
                                                    Background="{Binding LastStatus, Converter={StaticResource StatusBackgroundConverter}}">
                                                <TextBlock Text="{Binding LastStatusText}"
                                                           Foreground="{Binding LastStatus, Converter={StaticResource StatusForegroundConverter}}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Son Kontrol" Binding="{Binding LastCheckedAtText}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PanelSectionStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Kontrol Edilen Cihazlar" Style="{StaticResource SectionHeadingStyle}" />
                        <ItemsControl ItemsSource="{Binding Legacy.LiveCheckedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastStatusText}" FontWeight="SemiBold" />
                                        <Button Content="{Binding Name}"
                                                Command="{Binding DataContext.Shell.OpenDeviceDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryToolbarButtonStyle}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource PanelSectionStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Son Durum Degisiklikleri" Style="{StaticResource SectionHeadingStyle}" />
                        <DataGrid ItemsSource="{Binding Legacy.LiveRecentChanges}"
                                  Style="{StaticResource CompactDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                  MaxHeight="260">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource RowStatusBackgroundConverter}}" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding CheckedAtText}" Width="150" />
                                <DataGridTextColumn Header="IP / Hostname" Binding="{Binding IpAddress}" Width="150" />
                                <DataGridTextColumn Header="Cihaz" Binding="{Binding DeviceName}" Width="*" />
                                <DataGridTemplateColumn Header="Durum" Width="130" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPillStyle}"
                                                    Background="{Binding Status, Converter={StaticResource StatusBackgroundConverter}}">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusForegroundConverter}}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
