<UserControl x:Class="NetworkHealthMonitor.Views.Shell.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource ShellSurfaceBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="22,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding BreadcrumbText}"
                           Foreground="{StaticResource ShellSubtleTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding PageTitle}"
                           Style="{StaticResource ShellTitleTextStyle}"
                           Margin="0,3,0,0" />
                <TextBlock Text="{Binding PageDescription}"
                           Style="{StaticResource ShellSubtitleTextStyle}" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Geri"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource SecondaryToolbarButtonStyle}"
                        AutomationProperties.Name="Önceki sayfaya dön" />
                <Button Content="Yenile"
                        Command="{Binding RefreshCurrentPageCommand}"
                        Style="{StaticResource SecondaryToolbarButtonStyle}"
                        AutomationProperties.Name="Aktif sayfayı yenile" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
