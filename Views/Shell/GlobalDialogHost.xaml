<UserControl x:Class="NetworkHealthMonitor.Views.Shell.GlobalDialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:NetworkHealthMonitor.Views.Dialogs"
             IsHitTestVisible="{Binding Legacy.IsAnyDialogVisible}">
    <!--
      Root IsHitTestVisible only blocks when a dialog is open.
      Do NOT set IsHitTestVisible=False on a parent with IsHitTestVisible=True children:
      WPF excludes the entire visual subtree from hit-testing in that case.
    -->
    <Grid>
        <Grid Background="#66000000"
              Visibility="{Binding Legacy.IsDeviceFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="20"
              FocusManager.IsFocusScope="True">
            <dialogs:AddEditDeviceDialog HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         DataContext="{Binding Legacy}" />
        </Grid>

        <Grid Background="#66000000"
              Visibility="{Binding Legacy.IsSchedulePlanFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="19"
              FocusManager.IsFocusScope="True">
            <dialogs:AddEditScheduleDialog HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           DataContext="{Binding Legacy}" />
        </Grid>
    </Grid>
</UserControl>
