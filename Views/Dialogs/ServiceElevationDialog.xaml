<UserControl x:Class="NetworkHealthMonitor.Views.Dialogs.ServiceElevationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="480" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
        <StackPanel>
            <TextBlock Text="Yonetici Izni Gerekebilir" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Arka plan servis işlemleri gereken durumda Windows yetki yükseltme akışına devredilir." Style="{StaticResource BodyMutedTextStyle}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
