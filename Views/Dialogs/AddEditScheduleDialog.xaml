<UserControl x:Class="NetworkHealthMonitor.Views.Dialogs.AddEditScheduleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="620"
            MaxHeight="720"
            Background="{StaticResource ShellSurfaceBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18"
            KeyboardNavigation.TabNavigation="Cycle">
        <Border.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SaveSchedulePlanCommand}" />
            <KeyBinding Key="Escape" Command="{Binding CloseSchedulePlanFormCommand}" />
        </Border.InputBindings>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Kapat"
                            Command="{Binding CloseSchedulePlanFormCommand}"
                            Style="{StaticResource SecondaryToolbarButtonStyle}"
                            AutomationProperties.Name="Plan formunu kapat" />
                    <TextBlock Text="{Binding PlanFormTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,0,12,14" />
                </DockPanel>

                <TextBlock Text="Plan adi" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding PlanFormName}" Style="{StaticResource ModernTextBoxStyle}" />

                <TextBlock Text="Kapsam" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding PlanTargetTypeOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding PlanFormTargetType}"
                          Style="{StaticResource ModernComboBoxStyle}" />
                <ComboBox ItemsSource="{Binding PlanTargetOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding PlanFormTargetValue}"
                          Style="{StaticResource ModernComboBoxStyle}" />

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Siklik" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PlanFormFrequencyValue}" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Birim" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{Binding FrequencyUnitOptions}"
                                  SelectedItem="{Binding PlanFormFrequencyUnit}"
                                  Style="{StaticResource ModernComboBoxStyle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Zaman asimi" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PlanFormTimeoutMs}" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Paralel ping" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PlanFormMaxParallelism}" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>
                </UniformGrid>

                <CheckBox Content="Plan aktif"
                          IsChecked="{Binding PlanFormIsActive}"
                          Margin="0,8,0,12"
                          AutomationProperties.Name="Plan aktif" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Iptal"
                            Command="{Binding CloseSchedulePlanFormCommand}"
                            Style="{StaticResource SecondaryToolbarButtonStyle}"
                            AutomationProperties.Name="Plan formunu iptal et" />
                    <Button Content="{Binding PlanFormActionText}"
                            Command="{Binding SaveSchedulePlanCommand}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.Name="Plani kaydet" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
