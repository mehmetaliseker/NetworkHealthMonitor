<UserControl x:Class="NetworkHealthMonitor.Views.Dialogs.NotificationRuleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="520" Background="{StaticResource ShellSurfaceBrush}" BorderBrush="{StaticResource ShellBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
        <StackPanel>
            <TextBlock Text="Bildirim Kurali" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Bildirim kurali alanlari mevcut ayar servisinden Bildirimler sayfasinda yonetiliyor." Style="{StaticResource BodyMutedTextStyle}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
