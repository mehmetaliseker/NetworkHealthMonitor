<UserControl x:Class="NetworkHealthMonitor.Views.Devices.Tabs.DeviceGeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelSectionStyle}" Margin="0,12,0,0">
        <WrapPanel>
            <StackPanel Width="230" Margin="0,0,18,12">
                <TextBlock Text="Cihaz adi" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.Name}" />
            </StackPanel>
            <StackPanel Width="230" Margin="0,0,18,12">
                <TextBlock Text="IP veya hostname" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.IpAddress}" />
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,18,12">
                <TextBlock Text="Tur" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.DeviceTypeText}" />
            </StackPanel>
            <StackPanel Width="200" Margin="0,0,18,12">
                <TextBlock Text="Grup" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.GroupName}" />
            </StackPanel>
            <StackPanel Width="420" Margin="0,0,18,12">
                <TextBlock Text="Açıklama" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.Description}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,18,12">
                <TextBlock Text="Aktiflik" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.IsDeletedOrDisabledText}" />
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,18,12">
                <TextBlock Text="Son ping" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.LastCheckedAtText}" />
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,18,12">
                <TextBlock Text="Son gecikme" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.LastLatencyText}" />
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,18,12">
                <TextBlock Text="Uptime 24s" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.Uptime24HoursText}" />
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,18,12">
                <TextBlock Text="Uptime 30g" Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Text="{Binding Legacy.SelectedDevice.Uptime30DaysText}" />
            </StackPanel>
        </WrapPanel>
    </Border>
</UserControl>
