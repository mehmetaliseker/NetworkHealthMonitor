<UserControl x:Class="NetworkHealthMonitor.Views.Worker.WorkerServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScrollStyle}">
        <StackPanel>
            <Border Style="{StaticResource InlineNoticeStyle}">
                <TextBlock Text="{Binding Legacy.WorkerServiceDescription}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource PanelSectionStyle}">
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,18,10"><TextBlock Text="Servis Durumu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.WorkerHealthText}" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Margin="0,0,18,10"><TextBlock Text="Başlangıç Türü" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.WorkerStartupBehaviorText}" FontWeight="SemiBold" /></StackPanel>
                    <StackPanel Margin="0,0,18,10"><TextBlock Text="Son Baslama Zamani" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.WorkerStartedAtText}" /></StackPanel>
                    <StackPanel Margin="0,0,18,10"><TextBlock Text="Son Heartbeat" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.WorkerLastSeenAtText}" /></StackPanel>
                    <StackPanel Margin="0,0,18,10"><TextBlock Text="Kurulum Yolu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.WorkerInstallationPath}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Margin="0,0,18,10"><TextBlock Text="Veritabani Baglantisi" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.DatabaseLocation}" TextWrapping="Wrap" /></StackPanel>
                </UniformGrid>
            </Border>

            <Border Style="{StaticResource PanelSectionStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Legacy.WorkerServiceOperationsTitle}" Style="{StaticResource SectionHeadingStyle}" />
                    <WrapPanel>
                        <Button Content="Servisi Başlat" Command="{Binding Legacy.StartSchedulerCommand}" Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Arka plan servisini başlat" />
                        <Button Content="Servisi Durdur" Command="{Binding Legacy.StopSchedulerCommand}" Style="{StaticResource SecondaryToolbarButtonStyle}" AutomationProperties.Name="Arka plan servisini durdur" />
                        <Button Content="Servisi Yeniden Başlat" Command="{Binding Legacy.RestartWorkerServiceCommand}" Style="{StaticResource SecondaryToolbarButtonStyle}" AutomationProperties.Name="Arka plan servisini yeniden başlat" />
                        <Button Content="Servisi Kur" Command="{Binding Legacy.InstallWorkerServiceCommand}" Style="{StaticResource SecondaryToolbarButtonStyle}" AutomationProperties.Name="Arka plan servisini kur" />
                        <Button Content="Servisi Kaldır" Command="{Binding Legacy.UninstallWorkerServiceCommand}" Style="{StaticResource DangerToolbarButtonStyle}" AutomationProperties.Name="Arka plan servisini kaldır" />
                    </WrapPanel>
                    <CheckBox Content="{Binding Legacy.WorkerAutostartText}"
                              IsChecked="{Binding Legacy.WorkerAutostartEnabled}"
                              Margin="0,10,0,0"
                              AutomationProperties.Name="{Binding Legacy.WorkerAutostartText}" />
                    <TextBlock Text="{Binding Legacy.WorkerServiceControlMessage}" Style="{StaticResource BodyMutedTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
