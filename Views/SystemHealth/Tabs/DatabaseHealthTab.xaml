<UserControl x:Class="NetworkHealthMonitor.Views.SystemHealth.Tabs.DatabaseHealthTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelSectionStyle}" Margin="0,12,0,0">
        <UniformGrid Columns="2">
            <StackPanel Margin="0,0,18,10"><TextBlock Text="Veritabani yolu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.DatabaseLocation}" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="Dosya boyutu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.DatabaseFileSizeText}" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="WAL durumu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.DatabaseWalStatusText}" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="Son backup" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.DatabaseBackupText}" TextWrapping="Wrap" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="Son migration" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.LastMigrationText}" /></StackPanel>
        </UniformGrid>
    </Border>
</UserControl>
