<UserControl x:Class="NetworkHealthMonitor.Views.SystemHealth.Tabs.GeneralHealthTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelSectionStyle}" Margin="0,12,0,0">
        <UniformGrid Columns="2">
            <StackPanel Margin="0,0,18,10"><TextBlock Text="UI durumu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.UiStatusText}" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="Arka plan servisi" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.WorkerHealthText}" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="Tray durumu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.TrayStatusText}" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="SQLite durumu" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.SQLiteStatusText}" /></StackPanel>
            <StackPanel Margin="0,0,18,10"><TextBlock Text="Son heartbeat" Style="{StaticResource FieldLabelStyle}" /><TextBlock Text="{Binding Legacy.WorkerLastSeenAtText}" /></StackPanel>
        </UniformGrid>
    </Border>
</UserControl>
